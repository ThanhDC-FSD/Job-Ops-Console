# Default deny. Only explicitly allow tracked source and docs.
*

# Root files and repo metadata.
!.gitignore
!AGENTS.md
!README.md
!learning_plan.md
!PROJECT_STRUCTURE.md
!CV_REWRITE_STRICT_GUIDE.md
!requirements.txt
!apply-tech.ps1
!start-clash.bat
!CD
!Dev

# Source trees we want to track.
!apps/
!apps/**
!docs/
!docs/**
!scripts/
!scripts/**
!tests/
!tests/**
!showcase_assets/
!showcase_assets/**

# Selected temp workspaces to track.
!tmp_seek_automation/
!tmp_seek_automation/**
!tmp_seek_automation/README.md
!tmp_seek_automation/requirements.txt
!tmp_seek_automation/pyproject.toml
!tmp_seek_automation/uv.lock
!tmp_seek_automation/.env.example
!tmp_seek_automation/.python-version
!tmp_sqlite_tools/
!tmp_sqlite_tools/**
!tmp/
tmp/*
!tmp/intro_slides/
!tmp/intro_slides/**

# Keep sensitive or generated content out of git.
.env
.venv/
.venv_broken/
**/node_modules/
**/node_modules/**
**/dist/
**/dist/**
**/logs/
**/logs/**
**/__pycache__/
**/__pycache__/**
**/.pytest_cache/
**/.pytest_cache/**
tmp_seek_automation/data/
tmp_seek_automation/data/**
tmp_seek_automation/input/
tmp_seek_automation/input/**
tmp_seek_automation/locks/
tmp_seek_automation/locks/**
tmp_seek_automation/pauses/
tmp_seek_automation/pauses/**
tmp_seek_automation/benchmarks/results/
tmp_seek_automation/benchmarks/results/**
input/
input/**
documents/
documents/**
artifacts/
artifacts/**
showcase_assets/CV/
showcase_assets/CV/**
*.docx
*.pdf
*.txt
*.sqlite
*.sqlite3
*.pyc
tmp_seek_automation/.git/
tmp_seek_automation/.git.disabled/
